---
import type { KauzaZaznam } from '../lib/validace';
import { rozdelOdstavce, odstavecNaHtml } from '../lib/souvislosti';
import { datumText, rozsahText, delkaText, polohaVKauze, popiskyRoku } from '../lib/casova-osa';
import { popisekStavu, pripominaPresumpci } from '../lib/stavy';
import { popisekKriteria } from '../lib/kriteria';
import { castkaText, popisekDruhu } from '../lib/castky';
import type { VazbyKauzy } from '../lib/mapa';
import SeznamZdroju from './SeznamZdroju.astro';
import type { SouvisejiciPravidlo } from '../lib/pravidla';

interface Props { zaznam?: KauzaZaznam; vazby?: VazbyKauzy; naMapu?: boolean; pravidla?: SouvisejiciPravidlo[] }
const { zaznam, vazby, naMapu = false, pravidla = [] } = Astro.props;
const REPO = 'https://github.com/posudtesami/posudtesami.cz';
const k = zaznam?.kauza;
const poloha = (d: string) => k ? polohaVKauze(d, k.od, k.do) : 0;
const posledni = k ? k.udalosti.length - 1 : 0;
const rokyOsy = k ? popiskyRoku(k.udalosti.map(u => ({ datum: u.datum, p: poloha(u.datum) }))) : [];
const maVazby = !!vazby && (vazby.akteri.length + vazby.navazuje.length + vazby.navazujiNaNi.length) > 0;
const chipy = (cisla: number[]) => cisla.map(c => `<a href="#zdroj-${c}" class="chip" data-zdroj="${c}" aria-label="Zdroj ${c}">${c}</a>`).join('');
---
<!-- Stránka kauzy má dialog otevřený už v HTML, aby byl obsah vidět i bez JavaScriptu; skript ho přepne na modální. -->
<dialog class={`detail m2${k?.do === null ? ' otevrena' : ''}`} id="detail" aria-labelledby="detail-nadpis" data-slug={zaznam?.slug} open={k ? true : undefined}>
  {k && zaznam && (
    <>
      <button class="zavrit" type="button" aria-label="Zavřít detail">×</button>
      <header class="m2-hlava">
        <div class="roky">{rozsahText(k.od, k.do)} · {delkaText(k.od, k.do)} · {popisekStavu(k.stav)}</div>
        {/* Název kauzy je nadpisem stránky. Detail s obsahem vzniká vždy jako samostatná stránka;
            na titulní stránce je dialog prázdný a skript do něj vloží obsah právě odtud. */}
        <h1 id="detail-nadpis">{k.nazev}</h1>
        <p class="perex" id="detail-perex">{k.shrnuti}</p>
        <button class="perex-vice" type="button" aria-expanded="false" aria-controls="detail-perex" hidden>celé shrnutí</button>
        {k.castky.length > 0 && (
          <ul class="castky" aria-label="Částky v kauze">
            {k.castky.map(c => <li class={c.druh === 'objem' ? 'objem' : undefined}><strong>{castkaText(c)}</strong> <span class="druh-castky">{popisekDruhu(c.druh)}</span> <span class="popis-castky">{c.popis}<span class="chipy" set:html={chipy(c.zdroje)}></span></span></li>)}
            <li class="castky-metodika"><a href="/metodika/#jazyk">Co částky znamenají</a></li>
          </ul>
        )}
      </header>
      <div class="mini-osa" aria-label="Události kauzy v čase">
        <div class="linie"></div>
        {k.udalosti.map((u, i) => <button class="bod" type="button" data-i={i} style={`--i:${i};left:${poloha(u.datum)}%`} aria-label={`${datumText(u.datum)}: ${u.nazev}`}></button>)}
        {rokyOsy.map(r => <span class="rok" style={`left:${r.p}%`}>{r.rok}</span>)}
        <span class="vybrany-popis"></span>
      </div>
      <div class="zalozky" role="tablist">
        <button role="tab" type="button" data-p="proc" aria-selected="true">Proč je to kauza</button>
        <button role="tab" type="button" data-p="chrono" aria-selected="false">Chronologie</button>
        <button role="tab" type="button" data-p="souv" aria-selected="false">Souvislosti</button>
        <button role="tab" type="button" data-p="stav" aria-selected="false">Stav a stanovisko</button>
        <button role="tab" type="button" data-p="zdroje" aria-selected="false">Zdroje ({k.zdroje.length})</button>
      </div>
      <div class="m2-panel" data-p="proc" role="tabpanel">
        <h3 class="panel-nadpis">Proč je to kauza</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
        <p class="proc-text">{k.proc.text}<span class="chipy" set:html={chipy(k.proc.zdroje)}></span></p>
        <p class="kriterium">Zařazeno podle metodiky: <a href="/metodika/#kriteria">{popisekKriteria(k.kriterium)}</a></p>
      </div>
      <div class="m2-panel" data-p="chrono" role="tabpanel" hidden>
        <h3 class="panel-nadpis">Chronologie</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
        <ol class="udalosti-seznam">
          {k.udalosti.map((u, i) => (
            <li data-i={i} data-datum={u.datum}>
              <div class="udalost-velka">
                <time>{datumText(u.datum)}<small>událost {i + 1} z {k.udalosti.length}</small></time>
                <div><h3>{u.nazev}</h3><p>{u.popis}</p><div>Zdroje:<span class="chipy" set:html={chipy(u.zdroje)}></span></div></div>
              </div>
            </li>
          ))}
        </ol>
        <div class="listovani">
          <button type="button" data-krok="-1"><small>← předchozí</small><span></span></button>
          <button type="button" data-krok="1" style="text-align:right"><small>další →</small><span></span></button>
        </div>
      </div>
      <div class="m2-panel" data-p="souv" role="tabpanel" hidden>
        <h3 class="panel-nadpis">Souvislosti</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
        {rozdelOdstavce(zaznam.telo).map(o => <p set:html={odstavecNaHtml(o)}></p>)}
        {maVazby && vazby && (
          <section class="vazby" aria-labelledby="vazby-nadpis">
            <h3 id="vazby-nadpis">Aktéři a návaznosti</h3>
            <ul>
              {vazby.akteri.map(a => <li><strong>{a.nazev}</strong>, {a.roleText}: {a.popis}<span class="chipy" set:html={chipy(a.zdroje)}></span></li>)}
              {vazby.navazuje.map(n => <li><em>Navazuje na:</em> <a href={`/kauzy/${n.slug}/`} data-kauza={n.slug}>{n.nazev}</a> ({n.roleText}): {n.popis}<span class="chipy" set:html={chipy(n.zdroje)}></span></li>)}
              {vazby.navazujiNaNi.length > 0 && <li><em>Navazují na ni:</em> {vazby.navazujiNaNi.map((n, i) => <>{i > 0 && ', '}<a href={`/kauzy/${n.slug}/`} data-kauza={n.slug}>{n.nazev}</a></>)}</li>}
            </ul>
            {naMapu && <a class="na-mapu" href={`/?pohled=mapa&vyber=${zaznam.slug}`} data-na-mapu={zaznam.slug}>Ukázat na mapě →</a>}
          </section>
        )}
        {pravidla.length > 0 && (
          <section class="souvisejici-pravidla" aria-labelledby="pravidla-kauzy-nadpis">
            <h3 id="pravidla-kauzy-nadpis">Související zákony a nařízení</h3>
            <ul>
              {pravidla.map(p => <li><a href={`/pravidla/${p.slug}/`}>{p.nazev}</a> ({p.stav}): {p.popis}</li>)}
            </ul>
          </section>
        )}
      </div>
      <div class="m2-panel" data-p="stav" role="tabpanel" hidden>
        <h3 class="panel-nadpis">Stav a stanovisko</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
        <div class={`stav-box${k.do === null ? ' otevrena' : ''}`}>
          <div class="stav">{popisekStavu(k.stav)}</div>
          {k.stavPoznamka && <p>{k.stavPoznamka}</p>}
          {k.do === null && pripominaPresumpci(k.stav) && <p>Dokud soud pravomocně nerozhodne, platí presumpce neviny.</p>}
          <div class="overeno">{k.overeno ? <>Naposledy ověřeno {datumText(k.overeno)}</> : <strong>Koncept, zatím neověřeno</strong>}</div>
        </div>
        <div class="stav-vpravo">
          <div class="stanovisko"><h4>Stanovisko dotčené strany</h4><p>{k.stanovisko.text}<span class="chipy" set:html={chipy(k.stanovisko.zdroje)}></span></p></div>
          {k.opravy.length > 0 && <div class="opravy"><h4>Opravy</h4><ul>{k.opravy.map(o => <li>{datumText(o.datum)}: {o.popis}</li>)}</ul></div>}
        </div>
      </div>
      <div class="m2-panel" data-p="zdroje" role="tabpanel" hidden>
        <h3 class="panel-nadpis">{`Zdroje (${k.zdroje.length})`}</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
        <SeznamZdroju zdroje={k.zdroje} />
        <div class="paticka-detailu">
          <a href={`${REPO}/commits/main/obsah/kauzy/${zaznam.slug}.md`}>Historie změn této kauzy</a>
          <a href={`${REPO}/issues/new?template=oprava.yml&title=${encodeURIComponent('Oprava: ' + k.nazev)}`}>Nahlásit chybu</a>
          <a href="#" data-sdilet>Zkopírovat odkaz na kauzu</a>
        </div>
      </div>
    </>
  )}
</dialog>
