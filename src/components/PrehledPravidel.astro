---
import Zaklad from '../layouts/Zaklad.astro';
import PatickaRadek from './PatickaRadek.astro';
import PrubehPravidla from './PrubehPravidla.astro';
import OsaPravidel from './OsaPravidel.astro';
import { osaPravidel } from '../lib/osa-pravidel';
import { nactiPravidla, nactiStitky, nactiOblasti } from '../lib/kauzy';
import { bezPripominek, textPoctu, type OblastDetail } from '../lib/oblasti';
import { popisekCesty, popisekKomu, popisekZaveru, popisekZnaku, popisekDuvodu, DUVODY } from '../lib/pravidla-slovnik';
import { duvodyPravidla } from '../lib/pravidla';
import { stavPravidla, popisekKroku } from '../lib/pravidla-stavy';
import { vytvorPolozkuPravidla } from '../lib/hledani-pravidel';
import { jsonDoSkriptu } from '../lib/html';
import type { PravidloZaznam } from '../lib/validace';
import '../styles/hlavni.css';
import '../styles/pravidla.css';

interface Props { otevrene?: PravidloZaznam; otevrenaOblast?: OblastDetail }
const { otevrene, otevrenaOblast } = Astro.props;
const zaznamy = nactiPravidla();
const stitky = nactiStitky();
const osa = osaPravidel(zaznamy, new Date());
const oblasti = nactiOblasti();
const sOblastmi = oblasti.length > 0;
// čip má smysl, jen když nějaká změna připomínkové řízení vynechala
const sBezPripominek = zaznamy.some(z => bezPripominek(z.pravidlo.cesta));
const cipy = [...new Set(zaznamy.flatMap(z => z.pravidlo.stitky))]
  .map(id => ({ id, nazev: stitky.get(id) ?? id }))
  .sort((a, b) => a.nazev.localeCompare(b.nazev, 'cs'));
// Filtr důvodu má smysl, jen když archiv obsahuje záznamy s oběma důvody.
const duvody = DUVODY.filter(d => zaznamy.some(z => duvodyPravidla(z.pravidlo).includes(d)));
const sDuvody = duvody.length > 1;
const titulek = otevrene ? `${otevrene.pravidlo.nazev} — Posuďte sami`
  : otevrenaOblast ? `${otevrenaOblast.nazev} — Posuďte sami`
  : 'Změny pravidel — Posuďte sami';
const cesta = otevrene ? `/pravidla/${otevrene.slug}/` : otevrenaOblast ? `/pravidla/oblasti/${otevrenaOblast.id}/` : '/pravidla/';
// klíč otevřeného detailu pro navigaci: slug pravidla, nebo „oblasti/<id>“
const otevrena = otevrene?.slug ?? (otevrenaOblast ? `oblasti/${otevrenaOblast.id}` : undefined);
const popis = otevrene ? otevrene.pravidlo.shrnuti
  : otevrenaOblast ? (otevrenaOblast.data?.uvod.text ?? otevrenaOblast.popisek)
  : 'Zákony, nařízení, usnesení vlády a pokyny ministerstev od prosince 2025, u kterých rozbor archivu ukazuje prospěch pro Andreje Babiše nebo Agrofert, nebo které mění kontrolu moci a instituce na to upozornily.';
---
<Zaklad titulek={titulek} popis={popis} cesta={cesta} styly="hlavni" aktivni="pravidla" otevrena={otevrena}>
  <main class="hlavni-obsah">
    <section class="hero u2 pr-hero">
      <p class="u2-nad">Změny pravidel</p>
      <h1>Které změny pravidel prospívají Babišovi a Agrofertu nebo mění kontrolu moci</h1>
      <p class="u2-pod">Zákony, nařízení, usnesení vlády a pokyny ministerstev od prosince 2025. U každé změny rozbor se zdroji, upozornění institucí a stanovisko předkladatele.</p>
    </section>
    {zaznamy.length > 0 && (
      <>
        <h2 class="jen-ctecka">Hledání a filtry</h2>
        <div class="filtry f4 pr-filtry">
          <label class="f-hledat"><input type="search" placeholder="Hledat ve změnách pravidel…" aria-label="Hledat ve změnách pravidel"></label>
          <div class="f-cipy-obal">
            <div class="f-cipy" role="group" aria-label={sDuvody ? 'Důvod zařazení a témata' : 'Témata'}>
              {sDuvody && duvody.map(d => <button type="button" data-duvod={d} aria-pressed="false">{popisekDuvodu(d)}</button>)}
              {sDuvody && <span class="f-oddelovac" aria-hidden="true"></span>}
              {sBezPripominek && <button type="button" data-bez-pripominek aria-pressed="false">bez připomínkového řízení</button>}
              {sBezPripominek && <span class="f-oddelovac" aria-hidden="true"></span>}
              {cipy.map(c => <button type="button" data-stitek={c.id} aria-pressed="false">{c.nazev}</button>)}
            </div>
          </div>
          <label class="f-prepinac"><input type="checkbox" data-jen-projednavane> jen v projednávání</label>
          <div class="pr-pohled" role="group" aria-label="Zobrazení změn pravidel" hidden>
            {sOblastmi && <button type="button" data-pohled="oblasti" aria-pressed="true">Oblasti</button>}
            <button type="button" data-pohled="seznam" aria-pressed={String(!sOblastmi)}>Seznam</button>
            <button type="button" data-pohled="osa" aria-pressed="false">Časová osa</button>
          </div>
          <span class="vpravo"><span class="pocet" aria-live="polite"></span><button class="f-zrusit" type="button" hidden>Zrušit filtry</button></span>
        </div>
      </>
    )}
    {sOblastmi && (
      <section class="oblasti-pohled" data-oblasti-pohled aria-labelledby="oblasti-nadpis">
        <h2 class="jen-ctecka" id="oblasti-nadpis">Oblasti</h2>
        <p class="ob-uvod-prehledu">Změny pravidel podle oblastí státu. U každé oblasti vysvětlujeme, k čemu slouží, a u každé změny, co by znamenala pro vás.</p>
        <ul class="ob-karty">
          {oblasti.map(o => (
            <li class="ob-karta" data-oblast={o.id}>
              <a class="ob-btn" href={`/pravidla/oblasti/${o.id}/`} aria-haspopup="dialog">
                <strong>{o.nazev}</strong>
                <span class="ob-popisek">{o.popisek}</span>
                <span class="ob-pocty">{textPoctu(o.pocty)}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="ob-prazdno" hidden>Žádná změna pravidel neodpovídá filtru. <button type="button" data-zrusit>Zrušit filtry</button></p>
      </section>
    )}
    <h2 class="jen-ctecka">Změny pravidel</h2>
    <div class="pravidla-obal" hidden={sOblastmi}>
      <ul class="pravidla-seznam">
        {zaznamy.length === 0 && <li class="archiv-prazdny">Zatím tu nejsou žádné ověřené záznamy.</li>}
        {zaznamy.map(({ slug, pravidlo: p }) => (
          <li class="pr-radek" data-slug={slug}>
            <a class="pr-btn" href={`/pravidla/${slug}/`} aria-haspopup="dialog">
              <span class="pr-nazev">
                <strong title={p.nazev}>{p.nazev}</strong>
                <small><span class="pr-cesta">{popisekCesty(p.cesta)} · </span>{popisekKroku(stavPravidla(p.udalosti))}{p.prospech && ` · ${popisekKomu(p.prospech.komu)} · ${popisekZaveru(p.prospech.zaver)}`}{p.kontrolaMoci && ` · Kontrola moci: ${p.kontrolaMoci.znaky.map(popisekZnaku).join(', ')}`}{bezPripominek(p.cesta) && <> · <span class="stitek-bp">bez připomínkového řízení</span></>}</small>
                {p.prospech && <span class="pr-proc-radek">{p.prospech.proc.text}</span>}
              </span>
              {/* stav je v textu výše, ukazatel je pro čtečku nadbytečný */}
              <span class="pr-prubeh" aria-hidden="true"><PrubehPravidla druh={p.druh} udalosti={p.udalosti} /></span>
              <span class="otevrit" aria-hidden="true">Detail →</span>
            </a>
          </li>
        ))}
        <li class="prazdno" hidden>Žádná změna pravidel neodpovídá filtru. <button type="button" data-zrusit>Zrušit filtry</button></li>
      </ul>
    </div>
    {zaznamy.length > 0 && <OsaPravidel osa={osa} />}
  </main>
  <PatickaRadek />
  <Fragment slot="mimo"><slot name="detail" /></Fragment>
</Zaklad>
<script type="application/json" id="nv-pravidla" set:html={jsonDoSkriptu(zaznamy.map(z => vytvorPolozkuPravidla(z, stitky)))}></script>
<script>
  import { inicializujFiltrPravidel } from '../scripts/pravidla-filtr';
  import { inicializujNavigaciPravidel } from '../scripts/navigace-pravidel';
  import { oznacNacteno } from '../scripts/nacteno';
  inicializujFiltrPravidel();
  inicializujNavigaciPravidel();
  import { inicializujOsuPravidel } from '../scripts/osa-pravidel';
  inicializujOsuPravidel();
  oznacNacteno(1600);
</script>
