---
import Zaklad from '../layouts/Zaklad.astro';
import Uvod from './Uvod.astro';
import Osa from './Osa.astro';
import Portret from './Portret.astro';
import PatickaRadek from './PatickaRadek.astro';
import Filtry from './Filtry.astro';
import Mapa from './Mapa.astro';
import { nactiKauzy, nactiStitky, nactiGraf, maMapu } from '../lib/kauzy';
import type { KauzaZaznam } from '../lib/validace';
import '../styles/hlavni.css';
import '../styles/mapa.css';
import { WEB, titulek as nazevStranky, titulekKauzy } from '../lib/web';
import { webJsonLd, kauzaJsonLd } from '../lib/jsonld';

interface Props { otevrena?: KauzaZaznam }
const { otevrena } = Astro.props;
const zaznamy = nactiKauzy();
const stitky = nactiStitky();
const mapa = maMapu();
const titulek = otevrena
  ? titulekKauzy(otevrena.kauza.nazev, otevrena.kauza.od, otevrena.kauza.do)
  : nazevStranky('Archiv kauz Andreje Babiše');
const popis = otevrena ? otevrena.kauza.shrnuti : WEB.popis;
---
<Zaklad titulek={titulek} popis={popis} cesta={otevrena ? `/kauzy/${otevrena.slug}/` : '/'} styly="hlavni" aktivni="kauzy" otevrena={otevrena?.slug}
  jsonLd={otevrena ? kauzaJsonLd(otevrena) : webJsonLd()}>
  <main class="hlavni-obsah">
    <Uvod jakoNadpis={!otevrena} />
    <h2 class="jen-ctecka">Hledání a filtry</h2>
    <Filtry zaznamy={zaznamy} stitky={stitky} mapa={mapa} />
    <h2 class="jen-ctecka">Kauzy</h2>
    <Osa zaznamy={zaznamy} mapa={mapa}>{mapa && <Mapa slot="mapa" graf={nactiGraf()} />}</Osa>
  </main>
  <PatickaRadek legenda />
  <Fragment slot="mimo">
    <Portret />
    <slot name="detail" />
  </Fragment>
</Zaklad>
<script>
  import { inicializujOsu } from '../scripts/osa';
  import { inicializujMapu } from '../scripts/mapa';
  import { inicializujNavigaci } from '../scripts/navigace';
  inicializujOsu();
  inicializujMapu();
  inicializujNavigaci();
</script>
