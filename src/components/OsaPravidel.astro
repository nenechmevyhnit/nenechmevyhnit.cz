---
import type { Osa } from '../lib/osa-pravidel';
interface Props { osa: Osa }
const { osa } = Astro.props;
const styl = (x: number, posun = 0) => `left:${x}%;--posun:${posun}`;
// popisek bodu: „datum · krok nebo název · název pravidla“; u skupiny blízkých bodů se název pravidla uvede jednou na konci
const popisek = (b: { popisek: string; popisekSkupiny: string | null }, nazev: string) => `${b.popisekSkupiny ?? b.popisek} · ${nazev}`;
// druhý řádek u názvu: kde změna je, potom druh předpisu („Předloženo · vládní návrh zákona“)
const podtitul = (stav: string, cesta: string) => [stav, stav ? cesta.charAt(0).toLocaleLowerCase('cs') + cesta.slice(1) : cesta].filter(Boolean).join(' · ');
const udalosti = (n: number) => `${n} ${n === 1 ? 'událost' : n < 5 ? 'události' : 'událostí'}`;
---
<!-- Bez JavaScriptu zůstává skrytá: seznam nese stejné informace (spec osy, oddíl 2). -->
<section class="osa-pravidel" data-osa-pravidel aria-label="Časová osa změn pravidel" style={`--mesicu:${osa.znacky.length}`} hidden>
  <p class="op-prazdno" hidden>Žádná změna pravidel neodpovídá filtru. <button type="button" data-zrusit>Zrušit filtry</button></p>
  <p class="op-uvod">Každý řádek je jedna změna pravidel. Body ukazují, kdy se s ní něco stalo: kdy ji někdo navrhl, schválil nebo zamítl a kdy má začít platit. Po kliknutí na bod uvidíte podrobnosti a zdroje.</p>
  <div class="op-plocha" role="region" tabindex="0" aria-label="Časová osa">
    <div class="op-hlava" aria-hidden="true">
      <span class="op-roh"></span>
      <div class="op-mesice">
        {osa.znacky.map(z => <span class:list={['op-znacka', { rok: z.rok }]} style={`left:${z.x}%`}>{z.text}</span>)}
        <span class="op-dnes-popisek" style={`left:${osa.dnes}%`}>dnes</span>
      </div>
    </div>
    <ol class="op-radky">
      {osa.radky.map(r => (
        <li class="op-radek" data-slug={r.slug}>
          <a class="op-nazev" href={`/pravidla/${r.slug}/`} title={r.nazev} aria-haspopup="dialog"><strong>{r.nazev}</strong><small>{podtitul(r.stav, r.cesta)}</small></a>
          <div class="op-cas">
            <span class="op-dnes" style={`left:${osa.dnes}%`} aria-hidden="true"></span>
            {r.cara && <span class="op-cara" style={`left:${r.cara.od}%;width:${r.cara.do - r.cara.od}%`} aria-hidden="true"></span>}
            {r.caraBudouci && <span class="op-cara budouci" style={`left:${r.caraBudouci.od}%;width:${r.caraBudouci.do - r.caraBudouci.od}%`} aria-hidden="true"></span>}
            {r.drive && <a class="op-drive" aria-haspopup="dialog" href={`/pravidla/${r.slug}/?udalost=${r.drive.udalost}`} data-udalost={r.drive.udalost} aria-label={`${r.drive.pocet} starší: ${r.nazev}, ${udalosti(r.drive.pocet)} před prosincem 2025`}>◀ {r.drive.pocet} starší</a>}
            {r.body.map(b => b.udalost === null
              ? <span class:list={['op-bod', b.druh]} style={styl(b.x, b.posun)} tabindex="0" role="img" aria-label={`${r.nazev}: ${b.popisek}`} data-popisek={popisek(b, r.nazev)}></span>
              : <a class:list={['op-bod', b.druh]} aria-haspopup="dialog" style={styl(b.x, b.posun)} href={`/pravidla/${r.slug}/?udalost=${b.udalost}`} data-udalost={b.udalost} aria-label={`${r.nazev}: ${b.popisek}`} data-popisek={popisek(b, r.nazev)}></a>)}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <p class="op-legenda">
    <span><i class="op-bod krok" aria-hidden="true"></i> krok schvalování (návrh, hlasování, podpis)</span>
    <span><i class="op-bod konec" aria-hidden="true"></i> konec: zamítnuto, staženo nebo zrušeno</span>
    <span><i class="op-bod udalost" aria-hidden="true"></i> jiná událost, třeba stanovisko úřadu nebo rozhodnutí soudu</span>
    <span><i class="op-vzor" aria-hidden="true"></i> doba projednávání</span>
    <span><i class="op-vzor budouci" aria-hidden="true"></i><i class="op-bod ucinnost" aria-hidden="true"></i> kdy má změna začít platit</span>
  </p>
  <div class="op-popisek" role="tooltip" hidden></div>
</section>
