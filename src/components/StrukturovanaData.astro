---
interface Props { data: object | object[] }
const { data } = Astro.props;
const seznam = Array.isArray(data) ? data : [data];
/** Řetězec „</script>“ uvnitř JSON by blok skriptu ukončil; escapuje se lomítko, JSON zůstane platný. */
const bezpecne = (d: object) => JSON.stringify(d).replace(/<\//g, '<\\/');
---
{seznam.map(d => <script type="application/ld+json" is:inline set:html={bezpecne(d)} />)}
