---
import type { PravidloZaznam } from '../lib/validace';
import PrubehPravidla from './PrubehPravidla.astro';
import VazbyPravidla from './VazbyPravidla.astro';
import SeznamZdroju from './SeznamZdroju.astro';
import { rozdelOdstavce, odstavecNaHtml } from '../lib/souvislosti';
import { datumText } from '../lib/casova-osa';
import { popisekCesty, popisekProspechu, vynechaneKontroly, popisekZnaku, popisekDruhuZnaku, upozornovatel, popisekTypuUpozornovatele, oblast } from '../lib/pravidla-slovnik';
import { stavPravidla, popisekKroku } from '../lib/pravidla-stavy';
import ZalozkaHlasovani from './ZalozkaHlasovani.astro';
import { nactiKauzy, nactiHlasovani } from '../lib/kauzy';
import { hlasovaniPravidla, cisloHlasovani } from '../lib/hlasovani';

interface Props { zaznam?: PravidloZaznam }
const { zaznam } = Astro.props;
const REPO = 'https://github.com/posudtesami/posudtesami.cz';
const p = zaznam?.pravidlo;
const nazvyKauz = new Map(nactiKauzy().map(z => [z.slug, z.kauza.nazev]));
const odstavce = zaznam ? rozdelOdstavce(zaznam.telo) : [];
const kontroly = p ? vynechaneKontroly(p.cesta) : [];
const hlasovani = p ? hlasovaniPravidla(p.udalosti, nactiHlasovani()) : [];
const velkym = (t: string) => t.charAt(0).toLocaleUpperCase('cs') + t.slice(1);
const chipy = (cisla: number[]) => cisla.map(c => `<a href="#zdroj-${c}" class="chip" data-zdroj="${c}" aria-label="Zdroj ${c}">${c}</a>`).join('');
// Záložky podle toho, co záznam má. Otevřená je první zobrazená (spec kontroly moci, oddíl 7).
const zalozky = p ? [
  ...(p.prospech ? [{ id: 'prospech', nazev: 'Komu prospívá' }] : []),
  ...(p.kontrolaMoci ? [{ id: 'kontrola', nazev: 'Kontrola moci' }] : []),
  { id: 'chrono', nazev: 'Průběh' },
  ...(hlasovani.length > 0 ? [{ id: 'hlasovani', nazev: `Hlasování (${hlasovani.length})` }] : []),
  { id: 'vyhrady', nazev: 'Výhrady a stanovisko' },
  ...(odstavce.length > 0 ? [{ id: 'souv', nazev: 'Souvislosti' }] : []),
  { id: 'zdroje', nazev: `Zdroje (${p.zdroje.length})` },
] : [];
const prvni = zalozky[0]?.id;
---
<!-- Stránka pravidla má dialog otevřený už v HTML, aby byl obsah vidět i bez JavaScriptu; skript ho přepne na modální. -->
<dialog class="detail m2 pravidlo" id="detail" aria-labelledby="detail-nadpis" data-slug={zaznam?.slug} open={p ? true : undefined}>
  {p && zaznam && (
    <>
      <button class="zavrit" type="button" aria-label="Zavřít detail">×</button>
      <header class="m2-hlava">
        <div class="roky">{popisekCesty(p.cesta)} · {popisekKroku(stavPravidla(p.udalosti))}{p.oblasti && p.oblasti.length > 0 && (
          <span class="pr-oblasti"> · Oblasti: {p.oblasti.map((o, i) => <>{i > 0 && ', '}<a href={`/pravidla/oblasti/${o}/`} data-oblast-odkaz={o} aria-haspopup="dialog">{oblast(o).nazev}</a></>)}</span>
        )}</div>
        <h1 id="detail-nadpis">{p.nazev}</h1>
        <p class="perex" id="detail-perex">{p.shrnuti}</p>
        <button class="perex-vice" type="button" aria-expanded="false" aria-controls="detail-perex" hidden>celé shrnutí</button>
        {p.proVas && (
          <div class="pro-vas-obal">
            <p class="pro-vas" id="detail-pro-vas"><strong>Co by to znamenalo pro vás:</strong> {p.proVas.text}<span class="chipy" set:html={chipy(p.proVas.zdroje)}></span></p>
            <button class="pro-vas-vice" type="button" aria-expanded="false" aria-controls="detail-pro-vas" hidden>celý text</button>
          </div>
        )}
        <PrubehPravidla druh={p.druh} udalosti={p.udalosti} interaktivni />
        {p.planovano && <p class="planovano">Stav k {datumText(p.planovano.stavK)}: {p.planovano.text}<span class="chipy" set:html={chipy(p.planovano.zdroje)}></span></p>}
      </header>
      <div class="zalozky" role="tablist">
        {zalozky.map(z => <button role="tab" type="button" data-p={z.id} aria-selected={String(z.id === prvni)}>{z.nazev}</button>)}
      </div>
      {p.prospech && (
        <div class="m2-panel" data-p="prospech" role="tabpanel" hidden={prvni !== 'prospech'}>
          <h3 class="panel-nadpis">Komu prospívá</h3>{/* jen bez JavaScriptu, kdy jsou všechny části pod sebou */}
          <p class="pr-zaver"><strong>{velkym(popisekProspechu(p.prospech.zaver, p.prospech.komu))}</strong></p>
          <p class="kriterium">Závěr je rozbor archivu podle metodiky, ne úřední zjištění. <a href="/metodika/#pravidla">Jak rozbor děláme</a></p>
          <p class="pr-proc"><strong>Proč by to prospělo:</strong> {p.prospech.proc.text}<span class="chipy" set:html={chipy(p.prospech.proc.zdroje)}></span></p>
          <ol class="retezec">
            {p.prospech.retezec.map(k => <li>{k.odhad && <span class="odhad">odhad</span>}{k.odhad && ' '}{k.text}<span class="chipy" set:html={chipy(k.zdroje)}></span></li>)}
          </ol>
          {p.prospech.dalsiDotceni && <p class="dalsi-dotceni"><strong>Koho dalšího se změna týká:</strong> {p.prospech.dalsiDotceni.text}<span class="chipy" set:html={chipy(p.prospech.dalsiDotceni.zdroje)}></span></p>}
          <VazbyPravidla kauzy={p.kauzy} nazvyKauz={nazvyKauz} idNadpisu="kauzy-pravidla-nadpis" />
        </div>
      )}
      {p.kontrolaMoci && (
        <div class="m2-panel" data-p="kontrola" role="tabpanel" hidden={prvni !== 'kontrola'}>
          <h3 class="panel-nadpis">Kontrola moci</h3>
          <p class="kriterium">Záznam upozornění institucí, ne hodnocení archivu. <a href="/metodika/#kontrola-moci">Jak záznam děláme</a></p>
          <h4>Co se mění</h4>
          <ul class="znaky">
            {p.kontrolaMoci.znaky.map(zn => (
              <li><strong>{popisekZnaku(zn)}</strong>{zn.druh === 'instituce' && <> ({popisekDruhuZnaku(zn.druh)})</>}: {zn.text}<span class="chipy" set:html={chipy(zn.zdroje)}></span></li>
            ))}
          </ul>
          <h4>Kdo upozornil a na co</h4>
          <ul class="upozorneni">
            {p.kontrolaMoci.upozorneni.map(u => {
              const kdo = upozornovatel(u.kdo);
              return <li><strong>{kdo.nazev}</strong> ({popisekTypuUpozornovatele(kdo.typ)}): {u.text}<span class="chipy" set:html={chipy(u.zdroje)}></span></li>;
            })}
          </ul>
          {!p.prospech && <VazbyPravidla kauzy={p.kauzy} nazvyKauz={nazvyKauz} idNadpisu="kauzy-pravidla-kontrola-nadpis" />}
        </div>
      )}
      <div class="m2-panel" data-p="chrono" role="tabpanel" hidden={prvni !== 'chrono'}>
        <h3 class="panel-nadpis">Průběh</h3>
        {/* na mobilu je „Stav k“ tady místo v hlavičce (hlavička má být nízká); na počítači je skrytý */}
        {p.planovano && <p class="planovano-prubeh">Stav k {datumText(p.planovano.stavK)}: {p.planovano.text}<span class="chipy" set:html={chipy(p.planovano.zdroje)}></span></p>}
        <div class="cesta-box" role="region" tabindex="0" aria-label="Cesta předložení">
          <p><strong>{popisekCesty(p.cesta)}</strong>{p.oznaceni && <>, {p.oznaceni}</>}. Předkládá: {p.predkladatel}.</p>
          {p.pripojenoK && <p>Připojeno k: {p.pripojenoK.nazev}<span class="chipy" set:html={chipy(p.pripojenoK.zdroje)}></span></p>}
          {kontroly.length > 0 && <ul class="vynechano" aria-label="Vynechané kontroly legislativního procesu">{kontroly.map(t => <li>{t}</li>)}</ul>}
          {p.ucinnostOd && <p>Účinnost od {datumText(p.ucinnostOd)}</p>}
        </div>
        <ol class="udalosti-seznam">
          {p.udalosti.map((u, i) => (
            <li data-i={i} data-datum={u.datum}>
              <div class="udalost-velka">
                <time>{datumText(u.datum)}<small>{u.krok ? popisekKroku(u.krok) : `událost ${i + 1} z ${p.udalosti.length}`}</small></time>
                <div><h3>{u.nazev}</h3><p>{u.popis}</p><div>Zdroje:<span class="chipy" set:html={chipy(u.zdroje)}></span></div>{u.hlasovani.length > 0 && <div class="hl-odkazy">Hlasování: {u.hlasovani.map((h, j) => <>{j > 0 && ' · '}<a href={`/hlasovani/${h.id}/`}>č. {cisloHlasovani(h.id)}</a></>)}</div>}</div>
              </div>
            </li>
          ))}
        </ol>
        <div class="listovani">
          <button type="button" data-krok="-1"><small>← předchozí</small><span></span></button>
          <button type="button" data-krok="1" style="text-align:right"><small>další →</small><span></span></button>
        </div>
      </div>
      {hlasovani.length > 0 && (
        <div class="m2-panel" data-p="hlasovani" role="tabpanel" hidden={prvni !== 'hlasovani'}>
          <ZalozkaHlasovani hlasovani={hlasovani} />
        </div>
      )}
      <div class="m2-panel" data-p="vyhrady" role="tabpanel" hidden={prvni !== 'vyhrady'}>
        <h3 class="panel-nadpis">Výhrady a stanovisko</h3>
        <div class="vyhrady">
          <h4>Výhrady institucí</h4>
          {p.vyhrady.length > 0
            ? <ul>{p.vyhrady.map(v => <li><strong>{v.kdo}:</strong> {v.text}<span class="chipy" set:html={chipy(v.zdroje)}></span></li>)}</ul>
            : <p>{p.kontrolaMoci ? 'Další výhrady institucí zatím nejsou zapsané. Upozornění ke kontrole moci jsou v záložce Kontrola moci.' : 'Výhrady institucí zatím nejsou zapsané.'}</p>}
        </div>
        <div class="stanovisko"><h4>Stanovisko předkladatele</h4><p>{p.stanovisko.text}<span class="chipy" set:html={chipy(p.stanovisko.zdroje)}></span></p></div>
        <div class="overeno">{p.overeno ? <>Naposledy ověřeno {datumText(p.overeno)}</> : <strong>Koncept, zatím neověřeno</strong>}</div>
        {p.opravy.length > 0 && <div class="opravy"><h4>Opravy</h4><ul>{p.opravy.map(o => <li>{datumText(o.datum)}: {o.popis}</li>)}</ul></div>}
      </div>
      {odstavce.length > 0 && (
        <div class="m2-panel" data-p="souv" role="tabpanel" hidden={prvni !== 'souv'}>
          <h3 class="panel-nadpis">Souvislosti</h3>
          {odstavce.map(o => <p set:html={odstavecNaHtml(o)}></p>)}
        </div>
      )}
      <div class="m2-panel" data-p="zdroje" role="tabpanel" hidden={prvni !== 'zdroje'}>
        <h3 class="panel-nadpis">{`Zdroje (${p.zdroje.length})`}</h3>
        <SeznamZdroju zdroje={p.zdroje} />
        <div class="paticka-detailu">
          <a href={`${REPO}/commits/main/obsah/pravidla/${zaznam.slug}.md`}>Historie úprav tohoto záznamu</a>
          <a href={`${REPO}/issues/new?template=oprava.yml&title=${encodeURIComponent('Oprava: ' + p.nazev)}`}>Nahlásit chybu</a>
          <a href="#" data-sdilet>Zkopírovat odkaz na změnu</a>
        </div>
      </div>
    </>
  )}
</dialog>
