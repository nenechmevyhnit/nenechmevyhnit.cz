---
import '../styles/fonty.css';
import '../styles/upravy.css';
import Hlavicka from '../components/Hlavicka.astro';
import { rezimKonceptu, maPravidla } from '../lib/kauzy';

interface Props {
  titulek: string;
  popis: string;
  cesta: string;
  styly: 'hlavni' | 'stranky';
  aktivni?: 'kauzy' | 'pravidla' | 'metodika' | 'o-projektu';
  otevrena?: string;
}
const { titulek, popis, cesta, styly, aktivni, otevrena } = Astro.props;
const url = new URL(cesta, Astro.site).toString();
const nahled = new URL('/obrazky/nahled.png', Astro.site).toString();
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{titulek}</title>
  <meta name="description" content={popis}>
  <link rel="canonical" href={url}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="cs_CZ">
  <meta property="og:site_name" content="Posuďte sami">
  <meta property="og:title" content={titulek}>
  <meta property="og:description" content={popis}>
  <meta property="og:url" content={url}>
  <meta property="og:image" content={nahled}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- třída js: styly pro návštěvníky bez JavaScriptu (html:not(.js)) se použijí jen tehdy, když skripty neběží -->
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body data-otevrena={otevrena}>
  <div class="wrap" id="obsah">
    <Hlavicka aktivni={aktivni} pravidla={maPravidla()} />
    <slot />
  </div>
  <slot name="mimo" />
  {rezimKonceptu() && <aside class="koncepty-stitek" aria-label="Režim náhledu">Koncepty · neověřeno · jen lokálně</aside>}
</body>
</html>
