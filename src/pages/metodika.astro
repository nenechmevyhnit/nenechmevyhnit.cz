---
import Zaklad from '../layouts/Zaklad.astro';
import KartyStranky from '../components/KartyStranky.astro';
import { metodika } from '../data/metodika';
import { maPravidla } from '../lib/kauzy';
import '../styles/stranky.css';
import { titulek as nazevStranky } from '../lib/web';
const sPravidly = maPravidla();
const obsah = metodika(sPravidly);
---
<Zaklad titulek={nazevStranky('Metodika')} popis="Pravidla, podle kterých vybíráme, ověřujeme a opravujeme kauzy i změny zákonů." cesta="/metodika/" styly="stranky" aktivni="metodika">
  <KartyStranky nadtitulek="Metodika" nadpis="Jak archiv vedeme" perex="Pravidla, podle kterých vybíráme, ověřujeme a opravujeme kauzy i změny zákonů."
    sekce={obsah.sekce} paticka={`Pravidla platí od ${obsah.platiOd}`}
    cta={{ nadpis: 'Chcete vědět víc?', text: 'Každá změna metodiky i kauz je veřejně dohledatelná.', odkaz: 'https://github.com/posudtesami/posudtesami.cz/commits/main', popisek: 'Historie změn' }} />
</Zaklad>
